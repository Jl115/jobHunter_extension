{
  "manifest_version": 3,
  "name": "Job Hunter Scraper",
  "version": "0.0.1",
  "description": "Automatically detects and extracts job postings from LinkedIn, Indeed, and Xing.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://www.xing.com/*",
    "http://localhost/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.xing.com/*"
      ],
      "js": ["src/content/index.ts"]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icon16.svg"
    }
  },
  "icons": {
    "16": "icon16.svg",
    "48": "icon16.svg",
    "128": "icon16.svg"
  }
}